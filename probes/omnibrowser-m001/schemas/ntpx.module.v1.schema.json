{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ntpx.module/v1",
  "title": "NTPX Module v1",
  "type": "object",
  "required": ["schema_version", "module_id", "name", "version", "category", "description", "dependencies", "default_state"],
  "properties": {
    "schema_version": {"const": "ntpx.module/v1"},
    "module_id": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "items": {"type": "object", "required": ["module_id", "required"], "properties": {"module_id": {"type": "string", "format": "uuid"}, "version_constraint": {"type": ["string", "null"]}, "required": {"type": "boolean"}}, "additionalProperties": true}},
    "default_state": {"enum": ["OFF", "ON", "AUTO", "ASK", "ONCE", "SESSION", "WORKSPACE", "SANDBOX_ONLY", "LOCKED", "DENIED"]},
    "health_check": {"type": ["string", "null"]},
    "help_ref": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
