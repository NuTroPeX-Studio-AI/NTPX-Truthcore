PORT=8787
# Bind address (default 0.0.0.0).
HOST=0.0.0.0
# Comma-separated provider hostnames the server may proxy to. Never put API keys here for BYOK mode.
# "*" allows any public HTTPS host (private/reserved destinations are still blocked); prefer an explicit list.
TRUTHCORE_ALLOWED_PROVIDER_HOSTS=api.example.com
# Set to 1 only behind a trusted reverse proxy so rate limiting keys on X-Forwarded-For.
TRUTHCORE_TRUST_PROXY=0
# Set to 1 when served exclusively over HTTPS to send Strict-Transport-Security.
TRUTHCORE_HSTS=0
